<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 第二课堂「扫一扫」识别签到码 / 个人码。 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- 应用内更新下载完 APK 后要交给系统安装器，Android 8.0 起需要这条权限。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
        学习通刷课 / 签到的前台服务：任务期间常驻通知。
        用 specialUse 而不是 dataSync：Android 15 禁止从 BOOT_COMPLETED 启动 dataSync
        等类型的前台服务，specialUse 不在该限制名单里，开机恢复才能生效。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 设备重启后若已登录且签到实时提醒开着，自动恢复签到监控。 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 心跳兜底优先使用精确闹钟；无授权时自动退化为非精确。 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 设置页引导用户把本应用加入电池优化白名单。 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.GuanLiTong"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- 把下载到 cache/updates 的 APK 以 content:// 交给系统安装器。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>

        <!-- 请销假截图在 Android 10 以下通过 FileProvider 交给分享面板。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.share"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".widget.DesktopWidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.GuanLiTong" />
        <receiver
            android:name=".widget.SmallDesktopWidgetReceiver"
            android:exported="true"
            android:label="管院通 · 小号">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/desktop_widget_small" />
        </receiver>
        <receiver
            android:name=".widget.MediumDesktopWidgetReceiver"
            android:exported="true"
            android:label="管院通 · 中号">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/desktop_widget_medium" />
        </receiver>
        <receiver
            android:name=".widget.LargeDesktopWidgetReceiver"
            android:exported="true"
            android:label="管院通 · 大号">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/desktop_widget_large" />
        </receiver>
        <receiver android:name=".widget.DesktopWidgetUpdateReceiver" android:exported="false">
            <intent-filter>
                <action android:name="com.sdmu.guanlitong.widget.REFRESH" />
            </intent-filter>
        </receiver>

        <!-- 心跳 / 任务划掉后的延迟重启：只接本应用闹钟的显式广播，不导出。 -->
        <receiver
            android:name=".service.CxKeepAliveReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.sdmu.guanlitong.action.SIGN_HEARTBEAT" />
                <action android:name="com.sdmu.guanlitong.action.SIGN_RESTART" />
                <action android:name="com.sdmu.guanlitong.action.SIGN_RETRY" />
            </intent-filter>
        </receiver>

        <!-- 重启 / 应用更新后恢复签到监控：仅认系统广播，不导出。 -->
        <receiver
            android:name=".service.CxBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 刷课 / 签到共用前台服务，只在 App 进程内启动，不导出。 -->
        <service
            android:name=".service.CxTaskService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="学习通签到监控与课程刷课后台任务" />
        </service>

        <!-- 学习通资料刷时长的前台服务：进程内跑心跳，通知显示进度与停止入口。 -->
        <service
            android:name=".service.CxDocService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="学习通资料阅读进度心跳与停止通知" />
        </service>

        <!-- 知到定时刷课的常驻通知服务：任务在进程内跑，本服务只发布进度与停止入口。 -->
        <service
            android:name=".service.ZhsTaskService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="知到课程刷课后台任务与进度通知" />
        </service>
    </application>

</manifest>
